# Copy to .env.local, then uncomment ONE of the blocks below.
#
#     cp .env.local.example .env.local
#
# .env.local is gitignored; this file is the tracked reference for what belongs in it.
#
# Note what does NOT change between (A) and (B): the API base URL is staging either way.
# What changes is the origin the browser serves the app from, because that is what
# decides whether the session cookie is sent. See
# docs/backend/AUTH-ENVIRONMENT-FINDINGS.md §4 and §6.

NEXT_PUBLIC_USE_MOCK=false


# ─── (A) localhost — depends on staging staying SameSite=None ────────────────────
#
#   npm run dev        →  http://localhost:3002
#
# localhost is cross-site with mamsaa.com, so the cookie survives only because staging
# currently sets SameSite=None. The day staging moves to Lax to match production, this
# configuration silently stops holding a session: login appears to succeed, then the
# first fetch 401s and bounces to /login. Use (B) then.

NEXT_PUBLIC_API_BASE_URL=https://staging.mamsaa.com


# ─── (B) local.mamsaa.com — same-site, survives SameSite=Lax  [preferred] ────────
#
#   npm run dev:https  →  https://local.mamsaa.com:3002
#
# Same registrable domain as staging.mamsaa.com, so a Lax cookie is sent normally and
# staging can be made to match production's auth exactly. Requires, one time:
#   1. hosts entry     127.0.0.1  local.mamsaa.com
#   2. a local certificate         (certificates/README.md)
#   3. https://local.mamsaa.com:3002 on the API CORS allowlist  ← backend must add this
# Setup steps: docs/backend/AUTH-ENVIRONMENT-FINDINGS.md §6.

# NEXT_PUBLIC_API_BASE_URL=https://staging.mamsaa.com


# ─── (C) mocks — no backend at all ──────────────────────────────────────────────
#
#   npm run dev        →  http://localhost:3002, everything served from src/lib/mock
#
# Sign in with any valid Saudi mobile and any six-digit code. +966500000002 signs in as the
# finance role, anything else as superadmin.

# NEXT_PUBLIC_USE_MOCK=true
# NEXT_PUBLIC_API_BASE_URL=


# ─── Production ─────────────────────────────────────────────────────────────────
#
# https://api.mamsaa.com is SameSite=Lax by design and CANNOT hold a session from a
# local origin — only admin.mamsaa.com is same-site with it. Do not point local
# development here; it is not a misconfiguration to be fixed.

# NEXT_PUBLIC_API_BASE_URL=https://api.mamsaa.com
